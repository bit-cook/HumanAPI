# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/humanapi?schema=public"

# Required service-level credential for every private REST/MCP route.
# Generate a long random value for each environment.
API_KEY="replace-with-a-long-random-api-key"

# Public application origin
APP_URL="http://localhost:3000"
NODE_ENV="development"

# MCP stdio client; HUMANAPI_API_KEY must equal the server API_KEY.
HUMANAPI_API_URL="http://localhost:3000/api/mcp"
HUMANAPI_API_KEY="replace-with-the-same-value-as-API_KEY"

# Optional Docker Compose PostgreSQL overrides. Defaults preserve pre-v1.2 volumes.
POSTGRES_DB="humanapi"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
